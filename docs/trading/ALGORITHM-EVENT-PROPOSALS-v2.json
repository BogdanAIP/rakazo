{
  "schema": "event_controller_proposals_v2",
  "operators": [
    {
      "id": "escrow-confirmation",
      "parent_id": "resettable-shock-memory",
      "role": "candidate",
      "hypothesis": "A surprise first stores a directional hypothesis without exposure. A later confirming observation releases a finite position lease. Contradiction destroys the stored hypothesis; waiting, expiration and rearming are explicit states.",
      "failure_addressed": "Prior resettable-memory rules repeatedly acted on the same evidence and lost after costs. Ordered event confirmation and nonrenewable position leases may avoid acting on transient shocks; this is a falsifiable hypothesis, not a novelty claim.",
      "features": {
        "impulse": [
          "sub",
          [
            "feature",
            "return"
          ],
          [
            "mean",
            8,
            [
              "feature",
              "return"
            ]
          ]
        ],
        "confirmation": [
          "feature",
          "return"
        ],
        "regime": [
          "feature",
          "range"
        ]
      },
      "detector": {
        "enter": 0.25,
        "release": 0.05,
        "confirm": 0.03,
        "hot": 1.0
      },
      "initial": "idle",
      "states": {
        "idle": {
          "exposure": "flat",
          "ttl": null,
          "expire_to": null,
          "rules": [
            {
              "when": {
                "trigger": "nonzero"
              },
              "to": "watch",
              "reference": "trigger"
            }
          ]
        },
        "watch": {
          "exposure": "flat",
          "ttl": [
            8,
            2
          ],
          "expire_to": "cooldown",
          "rules": [
            {
              "when": {
                "trigger": "opposite"
              },
              "to": "cooldown",
              "reference": "clear"
            },
            {
              "when": {
                "confirm": "opposite"
              },
              "to": "cooldown",
              "reference": "clear"
            },
            {
              "when": {
                "confirm": "same",
                "min_age": 1
              },
              "to": "active",
              "reference": "keep"
            }
          ]
        },
        "active": {
          "exposure": "reference",
          "ttl": [
            12,
            3
          ],
          "expire_to": "cooldown",
          "rules": [
            {
              "when": {
                "trigger": "opposite"
              },
              "to": "cooldown",
              "reference": "clear"
            }
          ]
        },
        "cooldown": {
          "exposure": "flat",
          "ttl": [
            6,
            3
          ],
          "expire_to": "idle",
          "rules": [
            {
              "when": {
                "calm": true,
                "trigger": "zero",
                "min_age": 3
              },
              "to": "idle",
              "reference": "clear"
            }
          ]
        }
      }
    },
